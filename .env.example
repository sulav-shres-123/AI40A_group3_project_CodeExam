# Copy this file to .env and fill in real values. Never commit .env.
# Make a SECRET_KEY with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-me

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=codeexam
MYSQL_PASSWORD=choose-a-local-password
MYSQL_DATABASE=codeexam_dev

JUDGE0_URL=http://localhost:2358

# development or production (production turns on secure cookies and turns off debug)
APP_ENV=development
